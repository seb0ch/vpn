[Interface]
PrivateKey = < PRIVATE_KEY >
Address = 10.8.0.1/24
ListenPort = < PORT >

Jc = < Jc >
Jmin = < Jmin >
Jmax = < Jmax >
S1 = < S1 >
S2 = < S2 >
S3 = < S3 >
S4 = < S4 >
H1 = < H1 >
H2 = < H2 >
H3 = < H3 >
H4 = < H4 >

# Forward-path policy for VPN clients (rules live in the container netns;
# rule order matters — drops must precede the final blanket ACCEPT):
#   1. no client-to-client traffic (hairpin via the server),
#   2. ALL client port-53 traffic (any destination) is DNAT'ed to the dns
#      container in PREROUTING — clients cannot bypass dnscrypt-proxy with
#      an external plain-DNS resolver (DoH/DoT on 443/853 cannot be caught
#      this way). The forwarded packet is then addressed to 172.20.0.2:53,
#      explicitly allowed here since it would otherwise hit the 172.16/12
#      drop,
#   3. cloud metadata (169.254/16), RFC1918, CGNAT (100.64/10) and the
#      Azure WireServer (168.63.129.16) unreachable,
#   4. everything else (the internet) forwarded.
PostUp = iptables -t mangle -I FORWARD 1 -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
PostUp = iptables -t nat -A POSTROUTING -s 10.8.0.0/24 -j MASQUERADE
PostUp = iptables -A FORWARD -i %i -o %i -j DROP
PostUp = iptables -A FORWARD -i %i -d 172.20.0.2 -p udp --dport 53 -j ACCEPT
PostUp = iptables -A FORWARD -i %i -d 172.20.0.2 -p tcp --dport 53 -j ACCEPT
PostUp = iptables -A FORWARD -i %i -d 169.254.0.0/16 -j DROP
PostUp = iptables -A FORWARD -i %i -d 10.0.0.0/8 -j DROP
PostUp = iptables -A FORWARD -i %i -d 172.16.0.0/12 -j DROP
PostUp = iptables -A FORWARD -i %i -d 192.168.0.0/16 -j DROP
PostUp = iptables -A FORWARD -i %i -d 100.64.0.0/10 -j DROP
PostUp = iptables -A FORWARD -i %i -d 168.63.129.16/32 -j DROP
PostUp = iptables -A FORWARD -i %i -j ACCEPT
PostUp = iptables -A FORWARD -o %i -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
PostUp = iptables -t nat -A PREROUTING -i %i -s 10.8.0.0/24 -p udp --dport 53 -j DNAT --to-destination 172.20.0.2:53
PostUp = iptables -t nat -A PREROUTING -i %i -s 10.8.0.0/24 -p tcp --dport 53 -j DNAT --to-destination 172.20.0.2:53

PostDown = iptables -t mangle -D FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
PostDown = iptables -t nat -D POSTROUTING -s 10.8.0.0/24 -j MASQUERADE
PostDown = iptables -D FORWARD -i %i -o %i -j DROP
PostDown = iptables -D FORWARD -i %i -d 172.20.0.2 -p udp --dport 53 -j ACCEPT
PostDown = iptables -D FORWARD -i %i -d 172.20.0.2 -p tcp --dport 53 -j ACCEPT
PostDown = iptables -D FORWARD -i %i -d 169.254.0.0/16 -j DROP
PostDown = iptables -D FORWARD -i %i -d 10.0.0.0/8 -j DROP
PostDown = iptables -D FORWARD -i %i -d 172.16.0.0/12 -j DROP
PostDown = iptables -D FORWARD -i %i -d 192.168.0.0/16 -j DROP
PostDown = iptables -D FORWARD -i %i -d 100.64.0.0/10 -j DROP
PostDown = iptables -D FORWARD -i %i -d 168.63.129.16/32 -j DROP
PostDown = iptables -D FORWARD -i %i -j ACCEPT
PostDown = iptables -D FORWARD -o %i -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
PostDown = iptables -t nat -D PREROUTING -i %i -s 10.8.0.0/24 -p udp --dport 53 -j DNAT --to-destination 172.20.0.2:53
PostDown = iptables -t nat -D PREROUTING -i %i -s 10.8.0.0/24 -p tcp --dport 53 -j DNAT --to-destination 172.20.0.2:53
