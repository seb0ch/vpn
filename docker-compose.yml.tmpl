name: vpn

networks:
  vpn:
    name: vpn
    driver: bridge
    enable_ipv6: false
    ipam:
      config:
        - subnet: 172.20.0.0/24

services:
  # >>> service: dns
  # DNS — dnscrypt-proxy, authenticates and encrypts all DNS queries.
  # Not published to the host; reachable only within the vpn network.
  # Deployed with AmneziaWG only: AWG clients are DNAT'ed here, while Xray
  # resolves through the public servers in its own config.json.
  dns:
    image: dns:__DNS_TAG__
    container_name: vpn-dns
    restart: unless-stopped
    logging:
      driver: "none"
    networks:
      vpn:
        ipv4_address: 172.20.0.2
    cap_add:
      - NET_BIND_SERVICE
    expose:
      - "53/udp"
      - "53/tcp"
    healthcheck:
      test: ["CMD", "drill", "@127.0.0.1", "cloudflare.com"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
  # <<< service: dns

  # >>> service: amneziawg
  # AmneziaWG — obfuscated WireGuard VPN server.
  # Rendered only when ENABLE_AMNEZIAWG is on; deploy.sh drops everything
  # between these markers otherwise (see lib/common.sh:render_compose).
  amneziawg:
    image: amneziawg:__AWG_TAG__
    container_name: vpn-amneziawg
    restart: unless-stopped
    logging:
      driver: "none"
    networks:
      vpn:
        ipv4_address: 172.20.0.3
    ports:
      - "0.0.0.0:AWG_PORT:AWG_PORT/udp"
    volumes:
      # Mounted read-only; host-side scripts write to this directory for hot-reload.
      - ./amneziawg/conf:/etc/awg:ro
    cap_add:
      - NET_ADMIN
    sysctls:
      - net.ipv4.ip_forward=1
      - net.ipv4.conf.all.src_valid_mark=1
    healthcheck:
      test: ["CMD", "awg", "show", "awg0"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    depends_on:
      dns:
        condition: service_healthy
  # <<< service: amneziawg

  # >>> service: xray
  # Xray REALITY — VLESS proxy disguised as HTTPS traffic to cloudflare.com.
  # Rendered only when ENABLE_XRAY is on; deploy.sh drops everything between
  # these markers otherwise (see lib/common.sh:render_compose).
  xray:
    image: xray:__XRAY_TAG__
    container_name: vpn-xray
    restart: unless-stopped
    logging:
      driver: "none"
    networks:
      vpn:
        ipv4_address: 172.20.0.4
    ports:
      - "0.0.0.0:443:443/tcp"
    volumes:
      - ./xray/conf:/etc/xray
    healthcheck:
      # pgrep is provided by BusyBox on Alpine — checks the process is running.
      test: ["CMD", "pgrep", "xray"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    # >>> needs: dns
    depends_on:
      dns:
        condition: service_healthy
    # <<< needs: dns
  # <<< service: xray
